# 复制为 .env.local，填入真实值；不要提交 .env.local。
# SECRET_KEY：至少 32 字符，轮换前需执行手机号哈希迁移。
SECRET_KEY=replace-with-at-least-32-random-characters

# PostgreSQL 18 / Neon。必须使用 postgresql+psycopg://。
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Cloudflare R2；只使用核心流转时可留空，图片上传功能需要完整配置。
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=qinghe-circle-campus
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<PUBLIC_DEVELOPMENT_URL>.r2.dev

# 阿里云号码认证短信认证服务。本地无凭据时可使用 mock；Production 必须使用 aliyun_pnvs。
SMS_PROVIDER=mock
ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-ram-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
ALIYUN_PNVS_SIGN_NAME=replace-with-system-sign-name
ALIYUN_PNVS_TEMPLATE_CODE=replace-with-login-register-template-code
ALIYUN_PNVS_REGION_ID=cn-hangzhou

# 仅在自有域名已经通过 Cloudflare 代理到 Vercel 后设为 true。
TRUST_CLOUDFLARE_IP_HEADER=false
CLOUDFLARE_ORIGIN_SECRET=replace-with-cloudflare-origin-secret

# Cloudflare Turnstile：登录页安全验证。两项必须同时配置；留空时使用自托管图片验证码。
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 可选覆盖项；默认生产开启、测试关闭。本地视觉验收可设为 true。
LOGIN_VERIFICATION_ENABLED=true

# Production 只允许这些 Host 携带正确源站密钥后进入应用；留空则关闭 Host 限制。
PUBLIC_ALLOWED_HOSTS=qinghecircle.dpdns.org,qinghecircle.de5.net
