# 复制为 .env.local，填入真实值；不要提交 .env.local。
# SECRET_KEY：至少 32 字符，轮换前需执行手机号哈希迁移。
SECRET_KEY=replace-with-at-least-32-random-characters

# PostgreSQL 18 / Neon。必须使用 postgresql+psycopg://。
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Cloudflare R2；只使用核心流转时可留空，图片上传功能需要完整配置。
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=qinghe-circle-campus
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=https://<PUBLIC_DEVELOPMENT_URL>.r2.dev
